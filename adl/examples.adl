module examples {

import common.ui.ValidDoubleRange;

struct Name {
  String first;
  String last;
};

union Gender {
  Void female;
  Void male;
  String other;
};

struct Person {
  Name name;
  Word8 age;
  Gender gender;
  String role;
};

union Article {
  Void definite;
  Void indefinite;
};

struct Hierarchy {
  Person leader;
  Vector<Hierarchy> underlings;
};

struct SalaryEarner {
  String employeeId;

  Income income = 0;

  @ValidDoubleRange {"min": 0.10, "max": 0.48}
  Double tax_rate = 0.22;
    
};


@ValidDoubleRange { "min": 0, "max": 1000000 }
newtype Income = Double;

};
